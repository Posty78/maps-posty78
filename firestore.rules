rules_version = '2';
// Règles Firestore fusionnées — projet posty78-maps
// UID admin : P0bZ13Zs67PICnJiieYXiPgoGWs2
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloc existant (maps/giveaway/barbecue etc.) : lecture publique (site, overlay),
    // ecriture reservee a l'admin. Avant correction (audit du 03/09/2026), c'etait
    // "allow write: if true" - n'importe qui pouvait truquer currentMcdo depuis la
    // console du navigateur, sans mot de passe. currentMcdo est aussi mis a jour par
    // la Cloud Function checkMcdoPerimeter (Admin SDK, contourne ces regles).
    match /project/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
    }
    // Position live de l'APK de tracking : lecture publique (mini-map overlay + maps.posty78.fr).
    // Ecriture autorisee a tout client authentifie (l'APK se connecte en anonyme au demarrage,
    // aucun compte/mot de passe requis) ; seul le champ position est modifiable, pas currentMcdo
    // ni les autres champs geres par la Cloud Function.
    match /tracking/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(["lat", "lng", "updatedAt", "deviceId"]);
    }
    // Historique du tracé réel (points GPS accumulés), sharding hebdomadaire. Lecture publique
    // pour afficher la 2e polyligne sur maps.posty78.fr ; écriture réservée à la Cloud Function.
    match /tracking_history/{weekKey} {
      allow read: if true;
      allow write: if false;
    }
    // Lecture publique, écriture réservée à l'admin
    match /muscu_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
      // Exception : autoriser tout le monde à incrémenter/décrémenter
      // uniquement le champ "reactions" (pour les réactions emoji anonymes),
      // sans toucher au reste du document.
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);
    }
    match /muscu_template/{exoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
    }
    match /muscu_weights/{weightId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);
    }
    match /muscu_measurements/{measureId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);
    }
    match /muscu_food_entries/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);
    }
    match /muscu_supplements/{dateId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
    }
    match /muscu_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
    }

    // --- Preuves de consentement droit à l'image (rgpd.posty78.fr) ---
    match /consentements/{document} {
      // N'importe qui peut créer une preuve (le participant n'a pas de compte)
      allow create: if request.resource.data.keys().hasOnly(['horodatage', 'etape', 'geoloc', 'userAgent', 'versionTexte'])
                    && request.resource.data.etape is int;
      // Seul toi (connecté avec ton compte admin) peux lire les preuves
      allow read: if request.auth != null && request.auth.uid == "P0bZ13Zs67PICnJiieYXiPgoGWs2";
      // Personne ne peut modifier ou supprimer une preuve une fois créée
      allow update, delete: if false;
    }
  }
}
